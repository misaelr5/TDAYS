{
  "name": "travel-days-recrear",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3210",
    "build": "next build",
    "prebuild": "npm run verify:media",
    "verify:media": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-media.mjs",
    "start": "next start --hostname 127.0.0.1 --port 3210",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "build:qa": "node scripts/qa.mjs build",
    "test": "node scripts/qa.mjs test",
    "test:visual": "node scripts/qa.mjs test tests/visual.spec.ts"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "gsap": "3.15.0",
    "motion": "14.6.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
