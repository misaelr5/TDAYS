{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Default (no --env): review deployment on workers.dev only. Production lives in
  // env.production below and is deployed with `npm run cf:deploy:production`.
  "name": "travel-days-preview",
  // Wraps .open-next/worker.js to add byte-range support for /media/* (see the file).
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Serve verification HTML at its exact filename; Next owns page redirects.
    "html_handling": "none",
    "run_worker_first": ["/media/*"]
  },
  // next/image optimization through Cloudflare Images (free tier: 5,000 unique transformations/month).
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    // Requires the traveldays.tur.ar zone to be active in the same Cloudflare account.
    // Custom domains create their DNS records and certificates; www is redirected in next.config.ts.
    "production": {
      "name": "travel-days",
      "workers_dev": false,
      "routes": [
        { "pattern": "traveldays.tur.ar", "custom_domain": true },
        { "pattern": "www.traveldays.tur.ar", "custom_domain": true }
      ],
      "images": { "binding": "IMAGES" },
      "observability": { "enabled": true }
    }
  }
}
